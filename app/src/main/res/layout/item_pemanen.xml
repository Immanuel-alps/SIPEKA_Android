<?xml version="1.0" encoding="utf-8"?>
<!-- Pertemuan 11 – satu baris Data Pemanen (dipakai SimpleAdapter) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/tvInisial"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_badge"
        android:fontFamily="@font/inter_bold"
        android:gravity="center"
        android:textColor="@color/maroon_tua"
        android:textSize="14sp"
        tools:text="AS" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNama"
            style="@style/Teks.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Andi Saputra" />

        <TextView
            android:id="@+id/tvDetail"
            style="@style/Teks.Keterangan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            tools:text="2 kali panen • 3.460 kg" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPremi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_bold"
            android:textColor="@color/maroon_sawit"
            android:textSize="14sp"
            tools:text="Rp286.000" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_semibold"
            android:textColor="@color/jingga_brondolan"
            android:textSize="11sp"
            tools:text="1 menunggu" />
    </LinearLayout>
</LinearLayout>
