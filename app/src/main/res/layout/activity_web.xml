<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krem_kebun"
    android:orientation="vertical"
    tools:context=".WebActivity">

    <LinearLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/maroon_tua">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.SIPEKA.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />
    </LinearLayout>

    <!-- garis progress saat halaman web dimuat -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressWeb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        app:indicatorColor="@color/emas_premi"
        app:trackColor="@color/kuning_janjang"
        app:trackThickness="3dp" />

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
