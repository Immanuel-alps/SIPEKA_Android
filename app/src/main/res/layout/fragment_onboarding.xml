<?xml version="1.0" encoding="utf-8"?>
<!-- Pertemuan 11 – satu halaman On Board Screen (latar & isi diatur dari OnboardingFragment) -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_onboard_1"
    android:paddingStart="28dp"
    android:paddingTop="96dp"
    android:paddingEnd="28dp"
    android:paddingBottom="170dp"
    tools:context=".onboarding.OnboardingFragment">

    <!-- Ilustrasi: ikon di dalam 2 lingkaran (meniru dial timbangan) -->
    <FrameLayout
        android:id="@+id/ilustrasi"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_lingkaran_putih"
        app:layout_constraintBottom_toTopOf="@id/tvLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_lingkaran_putih">

            <ImageView
                android:id="@+id/ivIlustrasi"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:tint="@color/emas_premi"
                tools:src="@drawable/ic_agriculture" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/inter_bold"
        android:letterSpacing="0.12"
        android:textColor="@color/emas_premi"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/tvJudul"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ilustrasi"
        tools:text="1/3 • PENCATATAN PANEN" />

    <TextView
        android:id="@+id/tvJudul"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/lora_bold"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/putih_susu"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@id/tvDeskripsi"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLabel"
        tools:text="Catat panen langsung di kebun" />

    <TextView
        android:id="@+id/tvDeskripsi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:alpha="0.88"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/putih_susu"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvJudul"
        tools:text="Input berat, blok, mutu buah, dan kondisi lahan setiap pemanen dari HP." />
</androidx.constraintlayout.widget.ConstraintLayout>
