    <solid android:color="@color/putih_susu" />
    <stroke
        android:width="1.5dp"
        android:color="@color/jingga_brondolan"
        android:dashGap="5dp"
        android:dashWidth="8dp" />
    <corners android:radius="16dp" />
</shape>
