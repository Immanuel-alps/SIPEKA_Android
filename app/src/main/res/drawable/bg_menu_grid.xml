<?xml version="1.0" encoding="utf-8"?>
<!-- Pertemuan 11 – latar satu kotak menu di grid Beranda: kartu putih + efek riak (ripple) saat disentuh -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2676243A">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/putih_susu" />
            <stroke
                android:width="1dp"
                android:color="@color/garis" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</ripple>
